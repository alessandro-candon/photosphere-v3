# Dual-bucket GCP configuration
PHOTOSPHERE_MEDIA_BUCKET=your-project-photosphere-media
PHOTOSPHERE_DATA_BUCKET=your-project-photosphere-data

# Local staging directories
PHOTOSPHERE_SKIPPED_DIR=./skipped
PHOTOSPHERE_CACHE_DIR=./.photosphere-cache

# Pipeline behavior
PHOTOSPHERE_ROUTING_MODE=chronological
PHOTOSPHERE_TARGET_LANG=it
PHOTOSPHERE_DEVICE=auto

# Persistent AI / translation model caches (avoid /tmp/photosphere)
HF_HOME=./.photosphere-cache/hf
TORCH_HOME=./.photosphere-cache/torch

# Google Cloud ADC or local fake-gcs-server emulator
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/adc.json
# STORAGE_EMULATOR_HOST=http://localhost:4443
