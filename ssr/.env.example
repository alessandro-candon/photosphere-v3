# Firebase Web App Configuration (exposed safely to client)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-media-archive-bucket
FIREBASE_APP_ID=your-firebase-app-id

# Dual-Bucket GCS Architecture
# Media Bucket (ARCHIVE class) stores originals + 280x280 thumbnails/
PHOTOSPHERE_MEDIA_BUCKET=your-media-archive-bucket
# Data Bucket (STANDARD class) stores the 4 canonical JSON DBs + albums
PHOTOSPHERE_DATA_BUCKET=your-data-standard-bucket

# Mounted persistent disk cache directory (Cloud Run volume or local folder)
PHOTOSPHERE_MOUNTED_VOLUME_PATH=/mnt/photosphere

# Separated thumbnail cache (small 280x280 JPEGs, long TTL)
PHOTOSPHERE_THUMBNAIL_CACHE_DIRECTORY=thumbnail-cache
PHOTOSPHERE_THUMBNAIL_CACHE_TTL_MS=2592000000
PHOTOSPHERE_THUMBNAIL_CACHE_MAX_OBJECT_BYTES=5242880
PHOTOSPHERE_THUMBNAIL_CACHE_MAX_CACHE_BYTES=2147483648

# Separated original/video media cache (large payloads, shorter TTL)
PHOTOSPHERE_MEDIA_CACHE_DIRECTORY=media-cache
PHOTOSPHERE_MEDIA_CACHE_TTL_MS=43200000
PHOTOSPHERE_MEDIA_CACHE_MAX_OBJECT_BYTES=104857600
PHOTOSPHERE_MEDIA_CACHE_MAX_CACHE_BYTES=2147483648

# Strict Server-Side Access Control (fail closed if empty)
ALLOWED_EMAILS=user1@example.com,user2@example.com
ADMIN_EMAIL=user1@example.com

# Default UI language for labels & captions (falls back to en when absent)
NUXT_PUBLIC_DEFAULT_LANG=en

# Optional Firebase Admin credentials outside GCP Workload Identity
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
