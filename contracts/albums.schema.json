{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photosphere.local/contracts/albums.schema.json",
  "title": "PhotosphereAlbums",
  "description": "Array of user-defined Photosphere albums referencing media objects by SHA-1 hash.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "hashes"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "hashes": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
